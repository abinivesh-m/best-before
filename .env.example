# Best Before
#
# Bifrost gateway. Groq is the provider; the app asks for a fallback model in the
# request body, so a primary-model failure is retried inside the gateway.
BIFROST_URL=http://localhost:8080
BIFROST_KEY=
BIFROST_MODEL=groq/openai/gpt-oss-120b
BIFROST_FALLBACKS=groq/qwen/qwen3-32b

# Direct provider, used only when Bifrost is not running. The UI labels this mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Live web evidence. Without it, only the recorded demo samples can be verified.
TAVILY_API_KEY=
TAVILY_DEPTH=advanced
TAVILY_RESULTS=5

# Scoring thresholds and limits
CURRENT_AT=0.72
STALE_BELOW=0.45
MAX_CLAIMS=8
LLM_WORKERS=4
